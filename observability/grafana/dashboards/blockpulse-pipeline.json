{
  "uid": "blockpulse-pipeline",
  "title": "BlockPulse pipeline health",
  "tags": [
    "blockpulse"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Live health of the streaming lake sink from Prometheus: is it up, keeping up, fresh, and clean.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sink up",
      "description": "1 when Prometheus can scrape the kafka-lake sink.",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "up{job=\"blockpulse-stream-lake\"}",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Consumer lag",
      "description": "Messages behind the end of the enriched topic (alert above 1,000 for 2 min).",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "blockpulse_consumer_lag_messages",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Newest event age",
      "description": "Seconds since the newest event was received. Grows when data stops arriving (alert above 10 min). High during a replay of old data.",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "blockpulse_newest_event_age_seconds",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rows quarantined (10 min)",
      "description": "Rows that failed the lake contract recently.",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "sum(increase(blockpulse_rows_quarantined_total[10m]))",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "rate(blockpulse_messages_consumed_total[1m])",
          "legendFormat": "messages/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "rate(blockpulse_batches_total[1m])",
          "legendFormat": "batches/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rows written per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "sum by (table) (rate(blockpulse_rows_written_total[1m]))",
          "legendFormat": "{{table}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Consumer lag",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "blockpulse_consumer_lag_messages",
          "legendFormat": "lag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Time between batch flushes (p50 / p95)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "histogram_quantile(0.5, rate(blockpulse_batch_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "histogram_quantile(0.95, rate(blockpulse_batch_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
