[Unit]
Description=BlockPulse: capture the mempool feed in back-to-back sessions until the deadline
Documentation=file:///opt/blockpulse/app/docs/AWS_DEPLOY.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=blockpulse
Group=blockpulse
EnvironmentFile=/etc/blockpulse/collector.env
WorkingDirectory=/srv/blockpulse
ExecStart=/opt/blockpulse/venv/bin/python -m blockpulse collect-loop --root /srv/blockpulse/data --prefix session-aws --session-seconds ${BLOCKPULSE_SESSION_SECONDS} --url ${BLOCKPULSE_URL} --until ${BLOCKPULSE_DEADLINE} --min-free-gib ${BLOCKPULSE_MIN_FREE_GIB}
# Planned stops (deadline, session limit, low disk) exit 0 and are not restarted; crashes are.
Restart=on-failure
RestartSec=60
# SIGINT lets the capture write its summary before exiting (exit code 130 means a clean interrupt).
KillSignal=SIGINT
TimeoutStopSec=60
SuccessExitStatus=130
MemoryMax=1G
# Hardening: the service can only write its own data folder.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/blockpulse
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
