{
  "uid": "blockpulse-pipeline",
  "title": "BlockPulse pipeline health",
  "tags": [
    "blockpulse"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Live health of the streaming lake sink from Prometheus: is it up, keeping up, fresh, and clean.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Stream sink",
      "description": "Whether Prometheus can scrape the kafka-lake sink. DOWN means the process is gone or unreachable, not that it is idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "up{job=\"blockpulse-stream-lake\"}",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "index": 0
                },
                "0": {
                  "text": "DOWN",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Consumer lag",
      "description": "The larger of the sink's and the worker's lag: messages still to read. Alert above 1,000 for 2 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "max(blockpulse_consumer_lag_messages)",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Newest event age",
      "description": "Time since the newest event the sink has seen was received. It grows when the feed stops, and it starts high after replaying an old capture. Alert after 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "blockpulse_newest_event_age_seconds",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rows quarantined (10 min)",
      "description": "Rows that failed the lake contract recently.",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "sum(increase(blockpulse_rows_quarantined_total[10m]))",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Alerts firing",
      "description": "Alert rules currently firing in Prometheus. Pending rules (condition true, waiting out their 'for' window) are not counted.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput",
      "description": "Messages read from the enriched topic and micro-batches written, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "rate(blockpulse_messages_consumed_total{job=\"blockpulse-stream-lake\"}[1m])",
          "legendFormat": "messages/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "rate(blockpulse_batches_total[1m])",
          "legendFormat": "batches/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rows written per second",
      "description": "Rows written to each lake table per second, after the quality gate.",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "sum by (table) (rate(blockpulse_rows_written_total[1m]))",
          "legendFormat": "{{table}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Consumer lag",
      "description": "Messages still to read, per consumer: the enrichment worker on the raw topic and the sink on the enriched topic. The alert fires above 1,000 for two minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "blockpulse_consumer_lag_messages",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Time between batch flushes (p50 / p95)",
      "description": "How long the sink waits between writing batches. The target is 5 seconds; long gaps mean it is idle or stuck.",
      "datasource": {
        "type": "prometheus",
        "uid": "blockpulse-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "histogram_quantile(0.5, rate(blockpulse_batch_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "blockpulse-prom"
          },
          "expr": "histogram_quantile(0.95, rate(blockpulse_batch_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "links": [
    {
      "title": "Data overview",
      "type": "link",
      "url": "/d/blockpulse-overview",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": false
    }
  ]
}
